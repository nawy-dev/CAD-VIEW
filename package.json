{
  "name": "cad-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CAD-VIEW – عارض الرسومات الهندسية (DXF/DWG) يعمل أوفلاين كـ PWA ويُغلَّف لأندرويد بـ Capacitor",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sample": "tsx scripts/make-sample-dxf.ts",
    "verify": "npm run typecheck && npm run test && vite build && npm run e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.50.0",
    "sharp": ">=0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
